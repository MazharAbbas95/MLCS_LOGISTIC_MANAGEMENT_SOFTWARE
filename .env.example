# ============================================================
# MLCS Logistic Management Software — Environment Config
# Copy this file to .env and fill in your values
# ============================================================

# Server
PORT=3000
NODE_ENV=production

# Database — SQLite (built-in, no external server needed)
# The DB file lives at: prisma/dev.db
# No DATABASE_URL needed — Prisma uses the path in schema.prisma directly

# Security — GENERATE A STRONG SECRET FOR PRODUCTION!
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="CHANGE_ME_USE_A_LONG_RANDOM_STRING_IN_PRODUCTION"

# Chrome path — only needed for batch PDF generation via Puppeteer
# Leave blank to disable batch PDF (app works fully without it)
# CHROME_PATH=C:\Program Files (x86)\Google\Chrome\Application\chrome.exe

# Redis — only needed for background batch PDF queue (BullMQ)
# Leave blank to disable batch PDF queue (app works fully without it)
# REDIS_URL=redis://localhost:6379

# Initial Admin Account (used by: npx tsx prisma/seed.ts)
ADMIN_NAME="Mazhar Abbas"
ADMIN_USERNAME="admin"
ADMIN_INITIAL_PASSWORD="admin123"
