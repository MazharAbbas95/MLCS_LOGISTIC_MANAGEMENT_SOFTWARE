# Server Configuration
PORT=3000
NODE_ENV=production

# Database Configuration (MySQL 8.0)
# Change these values to your MySQL credentials
DATABASE_URL="mysql://root:yourpassword@localhost:3306/mlcs_db"

# Security Secrets
JWT_SECRET="mlcs-super-secret-key-2026-secure-vault"

# Infrastructure Paths
# Path to your Chrome/Chromium executable for PDF generation
CHROME_PATH="C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe"

# Redis Configuration (Required for BullMQ)
REDIS_URL="redis://localhost:6379"

# Application Identity
ADMIN_NAME="Mazhar Abbas"
