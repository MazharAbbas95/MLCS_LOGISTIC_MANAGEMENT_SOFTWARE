generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model VehicleRecord {
  id                Int      @id @default(autoincrement())
  srNo              String?
  biltyNo           String?
  truckNo           String?
  driverNo          String?
  partyKariya       Float?   @default(0)
  mlcsKariya        Float?   @default(0)
  vehicleKariya     Float?   @default(0)
  commission        Float?   @default(0)
  commissionStatus  String?  @default("Pending")
  description       String?  // tafseel maal
  loadingStation    String?
  unloadingStation  String?
  partyMillName     String?
  broker            String?
  tafseelAkhrajat   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  @@index([truckNo])
  @@index([biltyNo])
  @@index([createdAt])
}

model Expense {
  id           Int      @id @default(autoincrement())
  expenseMonth String
  date         String
  description  String
  amount       Float
  createdAt    DateTime @default(now())
  deletedAt    DateTime?

  @@index([createdAt])
  @@index([date])
}

model Bilty {
  id           Int      @id @default(autoincrement())
  biltyNo      String
  date         String
  truckNo      String
  driverNo     String
  cnic         String?  // Stored as JSON string
  origin       String
  destination  String
  sender       String
  receiver     String
  quantity     String
  description  String
  totalFare    String
  advance      String
  balance      String
  containerNo  String?  // Stored as JSON string
  shippingLine String?
  createdAt    DateTime @default(now())
  deletedAt    DateTime?

  @@index([biltyNo])
  @@index([truckNo])
  @@index([createdAt])
}

model Letterpad {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  createdAt DateTime @default(now())
  deletedAt DateTime?
}

model Report {
  id        Int      @id @default(autoincrement())
  period    String
  revenue   Float
  expenses  Float
  net       Float
  type      String
  details   String   // Stored as JSON string
  createdAt DateTime @default(now())
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String   // Hashed
  name      String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
